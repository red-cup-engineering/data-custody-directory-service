{
  "name": "@red-cup-engineering/data-custody-directory-service",
  "version": "0.3.2",
  "type": "module",
  "description": "Resolves and verifies the three lawful data/ custody directories -- logs, records, state -- a service's flatfile data may live under.",
  "license": "MIT",
  "keywords": [
    "computer-data",
    "561-group"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/data-custody-directory-service.git"
  },
  "exports": {
    ".": {
      "import": "./src/data-custody-directory.mjs"
    },
    "./resolve-data-custody-directory": {
      "import": "./scripts/resolve-data-custody-directory.mjs"
    },
    "./check-data-custody-directory": {
      "import": "./scripts/check-data-custody-directory.mjs"
    },
    "./migrate-data-custody-directory": {
      "import": "./scripts/migrate-data-custody-directory.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "resolve-data-custody-directory": "./scripts/resolve-data-custody-directory.mjs",
    "check-data-custody-directory": "./scripts/check-data-custody-directory.mjs",
    "migrate-data-custody-directory": "./scripts/migrate-data-custody-directory.mjs"
  },
  "files": [
    "README.md",
    "scripts",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
